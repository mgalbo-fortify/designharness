---
/**
 * Nightshift logo: a crescent whose inner edge is a lit window (the lamp
 * that stays on). Inline SVG so it adapts to dark sections.
 */
import { site } from "../../site.config";
interface Props {
  class?: string;
  /** Forwarded to the root (incl. the parent's scoped-style attribute). */
  [key: string]: unknown;
}
const { class: cls = "", ...rest} = Astro.props;
---

<span class:list={["logo", cls]} {...rest}>
  <svg class="logo__mark" viewBox="0 0 28 28" width="28" height="28" aria-hidden="true">
    <path d="M17.6 3.2A11 11 0 1 0 24.8 20.4 9 9 0 0 1 17.6 3.2Z" fill="currentColor"></path>
    <rect x="15.5" y="11" width="4.5" height="5.5" rx="0.8" fill="var(--color-accent)"></rect>
  </svg>
  <span class="logo__word">{site.name}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .logo__mark {
    width: 1.6rem;
    height: 1.6rem;
  }
</style>
