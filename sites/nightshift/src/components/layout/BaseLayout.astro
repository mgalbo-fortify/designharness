---
/**
 * BaseLayout — every page uses this. Handles <head> (SEO, Open Graph,
 * canonical, structured data, fonts), the motion boot, skip link, nav,
 * atmosphere layer and footer.
 */
import { Font } from "astro:assets";
import "../../styles/global.css";
import { site } from "../../site.config";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import Analytics from "./Analytics.astro";

interface Props {
  /** Page title. Rendered through site.titleTemplate unless `rawTitle`. */
  title?: string;
  rawTitle?: boolean;
  description?: string;
  /** Absolute or root-relative path to a 1200×630 image. Defaults to /og.png. */
  image?: string;
  noindex?: boolean;
  /** Hide the nav/footer (e.g. a standalone campaign page). */
  bare?: boolean;
  /** Extra classes on <body>. */
  bodyClass?: string;
  /** JSON-LD objects to add alongside the Organization schema. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  rawTitle = false,
  description = site.description,
  image = "/og.png",
  noindex = false,
  bare = false,
  bodyClass = "",
  schema = [],
} = Astro.props;

const fullTitle = !title ? site.name : rawTitle ? title : site.titleTemplate.replace("%s", title);
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: site.legalName || site.name,
    url: site.url,
    logo: new URL("/favicon.svg", site.url).href,
    sameAs: Object.values(site.social).filter(Boolean),
  },
  ...schema,
];
---

<!doctype html>
<html lang="en" data-smooth={String(site.motion.smoothScroll)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      Motion gate. Runs before first paint so hidden initial states never flash.
      .motion is only added when the visitor allows motion; .motion-paused
      restores a previous "Pause motion" choice.
    -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        try {
          if (!matchMedia("(prefers-reduced-motion: reduce)").matches) d.classList.add("motion");
          if (localStorage.getItem("motion") === "paused") d.classList.add("motion-paused");
        } catch (e) {}
      })();
    </script>

    <Font cssVariable="--ff-display" preload />
    <Font cssVariable="--ff-text" preload />
    <Font cssVariable="--ff-mono" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Analytics />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="background" />
    {!bare && <Nav />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer />}
    <script>
      import "../../motion/index.ts";
    </script>
  </body>
</html>
