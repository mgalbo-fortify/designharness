---
/**
 * ShiftLog — hero artifact. The evening's log as the shift starts: entries
 * land one by one (data-sequence) while the clock advances to match.
 * Illustrative data (see footer legal).
 */
import UIWindow from "./UIWindow.astro";

const entries = [
  { time: "6:02 PM", title: "Shift handoff", meta: "142 devices · 118 inboxes · 131 sign-ins watched", chip: "All quiet", tone: "ok" },
  { time: "7:41 PM", title: "Invoice phishing blocked", meta: "Sent to accounts@ from a look-alike domain", chip: "Blocked", tone: "ok" },
  { time: "9:15 PM", title: "Critical browser patch", meta: "Pushed to 3 laptops that missed it", chip: "Fixed", tone: "ok" },
  { time: "11:58 PM", title: "New-device sign-in", meta: "Front desk PC · confirmed with your IT provider", chip: "Verified", tone: "info" },
];
---

<UIWindow brand="Shift log" status="On shift" variant="ink" class="shiftlog" decorative>
  <div class="shiftlog__head">
    <div>
      <p class="type-micro shiftlog__label">Tonight</p>
      <p class="shiftlog__clock nums" data-shift-clock>6:02 PM</p>
    </div>
    <p class="type-micro shiftlog__analysts"><span class="shiftlog__live" aria-hidden="true"></span>3 analysts on</p>
  </div>
  <ol class="shiftlog__list" data-sequence data-sequence-start="1300" data-sequence-interval="1300" data-sequence-hold="4200" data-sequence-loop>
    {entries.map((e, i) => (
      <li class="entry" data-seq={i > 0 ? "" : undefined} data-time={e.time}>
        <span class="entry__time nums">{e.time}</span>
        <span class="entry__text">
          <span class="entry__title">{e.title}</span>
          <span class="entry__meta">{e.meta}</span>
        </span>
        <span class:list={["entry__chip", `entry__chip--${e.tone}`]}>{e.chip}</span>
      </li>
    ))}
  </ol>
</UIWindow>

<script>
  // Keep the big clock in step with the log entries as they land.
  document.querySelectorAll<HTMLElement>("[data-sequence]").forEach((seq) => {
    const clock = seq.closest(".shiftlog")?.querySelector<HTMLElement>("[data-shift-clock]");
    if (!clock) return;
    seq.addEventListener("sequence:step", (e) => {
      const item = (e as CustomEvent).detail.item as HTMLElement;
      clock.textContent = item.dataset.time ?? clock.textContent;
      clock.animate([{ opacity: 0.3, transform: "translateY(4px)" }, { opacity: 1, transform: "none" }], { duration: 420, easing: "cubic-bezier(.16,1,.3,1)" });
    });
  });
</script>

<style>
  .shiftlog {
    width: 100%;
    max-width: 30rem;
  }
  .shiftlog__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-line);
  }
  .shiftlog__label {
    color: var(--color-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .shiftlog__clock {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .shiftlog__analysts {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-ink-2);
  }
  .shiftlog__live {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px oklch(80% 0.15 72 / 0.2);
    animation: live 2s ease-in-out infinite alternate;
  }
  @keyframes live {
    to { box-shadow: 0 0 0 7px oklch(80% 0.15 72 / 0); }
  }
  .shiftlog__list {
    display: grid;
    gap: 0.5rem;
    min-height: 18.5rem;
    align-content: start;
  }
  .entry {
    display: grid;
    grid-template-columns: 4.6rem 1fr auto;
    align-items: start;
    gap: 0.75rem;
    padding: 0.8rem 0.9rem;
    border-radius: var(--radius-inner);
    background: oklch(100% 0 0 / 0.04);
    box-shadow: inset 0 0 0 1px var(--color-line);
    font-size: 0.8125rem;
    line-height: 1.35;
  }
  .entry__time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    padding-top: 0.1rem;
  }
  .entry__text {
    display: grid;
    min-width: 0;
  }
  .entry__title {
    font-weight: 600;
    color: var(--color-ink);
  }
  .entry__meta {
    color: var(--color-ink-3);
  }
  .entry__chip {
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-chip);
    font-size: 0.6875rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .entry__chip--ok {
    background: oklch(76% 0.14 155 / 0.16);
    color: oklch(84% 0.12 155);
  }
  .entry__chip--info {
    background: oklch(80% 0.15 72 / 0.16);
    color: var(--color-accent);
  }
</style>
