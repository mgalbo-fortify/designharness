---
/**
 * FAQ — native <details> accordions (keyboard and screen-reader friendly,
 * works without JS, searchable with find-in-page). Height animates with
 * `interpolate-size` where supported. Adds FAQPage structured data.
 *
 *   <FAQ items={[{ q: "Is there a monthly fee?", a: "No. …" }]} />
 *
 * Answers are plain text or simple HTML. Write questions the way a customer
 * would type them, and answer in the first sentence.
 */
interface Props {
  items: { q: string; a: string }[];
  schema?: boolean;
  class?: string;
  /** Forwarded to the root (incl. the parent's scoped-style attribute). */
  [key: string]: unknown;
}
const { items, schema = true, class: cls = "", ...rest} = Astro.props;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a.replace(/<[^>]+>/g, "") },
  })),
};
---

<div class:list={["faq", cls]} {...rest} data-reveal-group data-stagger="60">
  {items.map((item) => (
    <details class="faq__item" data-reveal>
      <summary class="faq__q">
        <span>{item.q}</span>
        <span class="faq__icon" aria-hidden="true"></span>
      </summary>
      <div class="faq__a" set:html={item.a} />
    </details>
  ))}
</div>
{schema && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<style>
  .faq {
    border-top: 1px solid var(--color-line);
    interpolate-size: allow-keywords;
  }
  .faq__item {
    border-bottom: 1px solid var(--color-line);
  }
  .faq__item::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 500ms var(--ease-out),
      content-visibility 500ms allow-discrete;
  }
  .faq__item[open]::details-content {
    block-size: auto;
  }
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.5rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--text-heading);
    line-height: var(--text-heading--line-height);
    letter-spacing: var(--text-heading--letter-spacing);
    font-weight: var(--font-weight-heading);
    color: var(--color-ink);
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    transition: background-color var(--dur-ui) var(--ease-out), transform 500ms var(--ease-out);
  }
  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.8rem;
    height: 1.5px;
    background: var(--color-ink);
    translate: -50% -50%;
    transition: rotate 500ms var(--ease-out);
  }
  .faq__icon::after {
    rotate: 90deg;
  }
  .faq__item[open] .faq__icon {
    transform: rotate(180deg);
    background: var(--color-sunken);
  }
  .faq__item[open] .faq__icon::after {
    rotate: 0deg;
  }
  .faq__q:hover .faq__icon {
    background: var(--color-sunken);
  }
  .faq__a {
    max-width: var(--measure);
    padding-bottom: 1.75rem;
    color: var(--color-ink-2);
  }
  .faq__a :global(p + p) {
    margin-top: 0.75em;
  }
  .faq__a :global(a) {
    color: var(--color-accent-deep);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
