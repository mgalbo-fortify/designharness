---
/**
 * DrawingSheet — the site's artifact frame: a drafting sheet with a hairline
 * border, a faint grid, corner registration ticks and a title block. Every
 * product artifact on the page sits on one, so the method reads as a set of
 * specified, reviewed drawings.
 */
interface Props {
  sheet: string;
  title: string;
  rev?: string;
  project?: string;
  grid?: boolean;
  class?: string;
  /** Forwarded to the root (incl. the parent's scoped-style attribute). */
  [key: string]: unknown;
}
const { sheet, title, rev = "A", project = "Applied AI", grid = true, class: cls = "", ...rest } = Astro.props;
---

<figure class:list={["sheet", grid && "sheet--grid", cls]} {...rest}>
  <span class="sheet__tick sheet__tick--tl" aria-hidden="true"></span>
  <span class="sheet__tick sheet__tick--tr" aria-hidden="true"></span>
  <span class="sheet__tick sheet__tick--bl" aria-hidden="true"></span>
  <span class="sheet__tick sheet__tick--br" aria-hidden="true"></span>
  <div class="sheet__body">
    <slot />
  </div>
  <figcaption class="sheet__block">
    <span class="sheet__cell sheet__cell--project">{project}</span>
    <span class="sheet__cell"><span class="sheet__k">Sheet</span>{sheet}</span>
    <span class="sheet__cell sheet__cell--title"><span class="sheet__k">Title</span>{title}</span>
    <span class="sheet__cell"><span class="sheet__k">Rev</span>{rev}</span>
  </figcaption>
</figure>

<style>
  .sheet {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    margin: 0;
    background: var(--color-surface);
    border-radius: var(--radius-artifact);
    box-shadow: 0 0 0 1px var(--color-line-strong), var(--shadow-lift);
    color: var(--color-ink);
    font-family: var(--font-sans);
  }
  .sheet--grid .sheet__body {
    background-image:
      linear-gradient(to right, oklch(36% 0.1 258 / 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, oklch(36% 0.1 258 / 0.05) 1px, transparent 1px);
    background-size: 1.25rem 1.25rem;
    background-position: -1px -1px;
  }
  .sheet__body {
    position: relative;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-radius: var(--radius-artifact) var(--radius-artifact) 0 0;
  }
  .sheet__tick {
    position: absolute;
    width: 0.75rem;
    height: 0.75rem;
    pointer-events: none;
    z-index: 1;
  }
  .sheet__tick::before,
  .sheet__tick::after {
    content: "";
    position: absolute;
    background: var(--color-ink-3);
  }
  .sheet__tick::before { inset: 50% 0 auto; height: 1px; }
  .sheet__tick::after { inset: 0 auto 0 50%; width: 1px; }
  .sheet__tick--tl { top: -0.375rem; left: -0.375rem; }
  .sheet__tick--tr { top: -0.375rem; right: -0.375rem; }
  .sheet__tick--bl { bottom: -0.375rem; left: -0.375rem; }
  .sheet__tick--br { bottom: -0.375rem; right: -0.375rem; }

  .sheet__block {
    display: grid;
    grid-template-columns: 1.4fr auto 1.6fr auto;
    border-top: 1px solid var(--color-line-strong);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    line-height: 1.3;
    color: var(--color-ink-2);
  }
  .sheet__cell {
    display: grid;
    gap: 0.1rem;
    padding: 0.55rem 0.75rem;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sheet__cell + .sheet__cell {
    border-left: 1px solid var(--color-line);
  }
  .sheet__cell--project {
    align-content: center;
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }
  .sheet__k {
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  @media (max-width: 520px) {
    .sheet__block {
      grid-template-columns: auto 1fr auto;
    }
    .sheet__cell--project {
      display: none;
    }
    .sheet__cell:nth-child(2) {
      border-left: 0;
    }
  }
</style>
