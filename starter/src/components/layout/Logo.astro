---
/**
 * Logo — replace per site. Keep the mark as inline SVG using currentColor
 * or theme variables so it adapts to dark sections. If the brand supplies a
 * logo file, inline its SVG here (don't <img> it: no color control, extra request).
 */
import { site } from "../../site.config";
interface Props {
  class?: string;
  /** Forwarded to the root (incl. the parent's scoped-style attribute). */
  [key: string]: unknown;
}
const { class: cls = "", ...rest} = Astro.props;
---

<span class:list={["logo", cls]} {...rest}>
  <svg class="logo__mark" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
    <rect x="2" y="2" width="20" height="20" rx="6" fill="var(--color-accent)"></rect>
    <path d="M8 12.5l2.6 2.6L16.5 9" fill="none" stroke="var(--color-accent-ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span class="logo__word">{site.name}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .logo__mark {
    width: 1.5rem;
    height: 1.5rem;
  }
</style>
