---
/**
 * Footer — brand, link columns, fine print and the motion pause control.
 * All content comes from site.config.ts.
 */
import { site } from "../../site.config";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container-site">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo />
        <p class="type-small measure">{site.description}</p>
      </div>
      {site.footer.columns.length > 0 && (
        <div class="footer__cols">
          {site.footer.columns.map((col) => (
            <div>
              <p class="type-label footer__title">{col.title}</p>
              <ul>
                {col.links.map((l) => (
                  <li><a href={l.href}>{l.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
    </div>

    {site.footer.legal.length > 0 && (
      <div class="footer__legal type-micro">
        {site.footer.legal.map((t) => <p>{t}</p>)}
      </div>
    )}

    <div class="footer__bottom type-small">
      <p>© {year} {site.legalName}</p>
      {site.motion.pauseControl && (
        <button type="button" class="footer__motion" data-motion-toggle aria-pressed="false">
          <span class="footer__motion-icon" aria-hidden="true"></span>
          <span data-motion-label>Pause motion</span>
        </button>
      )}
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: clamp(3.5rem, 2rem + 4vw, 6rem) 2rem;
    border-top: 1px solid var(--color-line);
    background: var(--color-paper);
    color: var(--color-ink-3);
  }
  .footer__top {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 900px) {
    .footer__top {
      grid-template-columns: 5fr 7fr;
    }
  }
  .footer__brand {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 2rem;
  }
  .footer__title {
    color: var(--color-ink);
    margin-bottom: 0.875rem;
  }
  .footer__cols ul {
    display: grid;
  }
  .footer__cols a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    font-size: var(--text-small);
    color: var(--color-ink-2);
    transition: color var(--dur-ui) var(--ease-out);
  }
  .footer__cols a:hover {
    color: var(--color-ink);
  }
  .footer__legal {
    display: grid;
    gap: 0.5rem;
    margin-top: 3rem;
    max-width: 60rem;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  .footer__motion {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 0.25rem;
    color: var(--color-ink-2);
    font: inherit;
  }
  .footer__motion:hover {
    color: var(--color-ink);
  }
  .footer__motion-icon {
    width: 0.75rem;
    height: 0.75rem;
    border-inline: 3px solid currentColor;
    border-block: 0 solid transparent;
  }
  .footer__motion[aria-pressed="true"] .footer__motion-icon {
    border-inline-width: 0 0;
    border-left: 0.7rem solid currentColor;
    border-block: 0.4rem solid transparent;
    height: 0;
  }
</style>
