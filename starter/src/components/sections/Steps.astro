---
/**
 * Steps — "how it works" as a numbered sequence joined by a line that draws
 * itself in. Three steps is ideal; four is the max before it becomes a list.
 *
 *   <Steps items={[{ title: "Open your account", body: "Five minutes, no paperwork." }, …]} />
 *
 * Steps aren't cards. They're a path, so they share one line.
 */
interface Props {
  items: { title: string; body: string }[];
  /** Heading level for step titles; match the page outline (h3 under an h2). */
  headingLevel?: "h3" | "h4";
  class?: string;
  /** Forwarded to the root (incl. the parent's scoped-style attribute). */
  [key: string]: unknown;
}
const { items, headingLevel: H = "h3", class: cls = "", ...rest} = Astro.props;
---

<ol class:list={["steps", cls]} {...rest} style={`--n:${items.length}`} data-reveal-group data-stagger="140">
  <span class="steps__line" data-reveal="rule" aria-hidden="true"></span>
  {items.map((s, i) => (
    <li class="steps__item" data-reveal>
      <span class="steps__num nums" aria-hidden="true">{i + 1}</span>
      <H class="type-heading">{s.title}</H>
      <p class="type-body">{s.body}</p>
    </li>
  ))}
</ol>

<style>
  .steps {
    position: relative;
    display: grid;
    gap: 2.5rem;
    counter-reset: step;
  }
  /* Phones: number in a rail on the left, text beside it. */
  .steps__item {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    column-gap: 1.25rem;
    row-gap: 0.4rem;
    align-content: start;
  }
  .steps__item > :not(.steps__num) {
    grid-column: 2;
  }
  .steps__num {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-weight: 700;
    box-shadow: 0 0 0 6px var(--color-paper), var(--shadow-button);
  }
  .steps__line {
    position: absolute;
    left: 1.375rem;
    top: 1.375rem;
    bottom: 2rem;
    width: 1.5px;
    background: var(--color-line-strong);
    transform-origin: top center;
  }
  .steps__line:global([data-reveal="rule"]) {
    --reveal-from: scaleY(0);
    transition-duration: 1600ms;
  }
  .steps__item p {
    max-width: 22rem;
  }
  @media (min-width: 900px) {
    .steps__item {
      grid-template-columns: 1fr;
      row-gap: 0.6rem;
    }
    .steps__item > :not(.steps__num) {
      grid-column: 1;
    }
    .steps__num {
      grid-row: auto;
      margin-bottom: 0.75rem;
    }
    .steps {
      grid-template-columns: repeat(var(--n), 1fr);
      gap: clamp(2rem, 1rem + 3vw, 4rem);
    }
    .steps__line {
      top: 1.375rem;
      left: 1.375rem;
      right: 0;
      bottom: auto;
      width: auto;
      height: 1.5px;
      transform-origin: left center;
    }
    .steps__line:global([data-reveal="rule"]) {
      --reveal-from: scaleX(0);
    }
  }
</style>
