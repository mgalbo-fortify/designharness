---
/**
 * Quote — one testimonial, set large. Real name, role and company are
 * required: an unattributed quote reads as fake. Never invent testimonials;
 * if the brief has none, leave this section out.
 */
interface Props {
  quote: string;
  name: string;
  role?: string;
  avatar?: string;
  size?: "lg" | "md";
  class?: string;
  /** Forwarded to the root (incl. the parent's scoped-style attribute). */
  [key: string]: unknown;
}
const { quote, name, role, avatar, size = "lg", class: cls = "", ...rest} = Astro.props;
---

<figure class:list={["quote", `quote--${size}`, cls]} {...rest} data-reveal>
  <blockquote>
    <p>“{quote}”</p>
  </blockquote>
  <figcaption>
    {avatar && <img src={avatar} alt="" width="48" height="48" loading="lazy" decoding="async" />}
    <span>
      <strong>{name}</strong>
      {role && <span class="quote__role">{role}</span>}
    </span>
  </figcaption>
</figure>

<style>
  .quote {
    display: grid;
    gap: 2rem;
  }
  .quote blockquote p {
    font-family: var(--font-display);
    font-weight: var(--font-weight-heading);
    color: var(--color-ink);
    text-wrap: balance;
    text-indent: -0.4em;
  }
  .quote--lg blockquote p {
    font-size: var(--text-title);
    line-height: 1.12;
    letter-spacing: var(--text-title--letter-spacing);
  }
  .quote--md blockquote p {
    font-size: var(--text-heading);
    line-height: 1.3;
    letter-spacing: var(--text-heading--letter-spacing);
  }
  .quote figcaption {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    font-size: var(--text-small);
  }
  .quote img {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    object-fit: cover;
  }
  .quote figcaption > span {
    display: grid;
  }
  .quote__role {
    color: var(--color-ink-3);
  }
</style>
